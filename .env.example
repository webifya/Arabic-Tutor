# Public application metadata. Only NEXT_PUBLIC_* values are browser-visible.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Lisan
NEXT_PUBLIC_APP_TAGLINE=আরবি শিখুন সহজভাবে
NEXT_PUBLIC_DEFAULT_LOCALE=bn

# Auth.js / NextAuth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=false

# 32 random bytes, base64-encoded. Required before database-stored provider credentials.
# Generate separately from AUTH_SECRET and keep outside the database.
APP_ENCRYPTION_KEY=

# Optional private absolute path. Defaults to <application root>/.runtime-config.json.
LISAN_RUNTIME_CONFIG_PATH=

# Normally set automatically by server.cjs. Set explicitly only for a custom startup layout.
LISAN_APPLICATION_ROOT=

# Comma-separated HTTPS hostnames allowed for custom AI provider testing during install.
INSTALLER_ALLOWED_AI_HOSTS=

# MySQL/MariaDB. Encode special URL characters in credentials.
DATABASE_URL=mysql://lisan_user:change-me@127.0.0.1:3306/lisan

# Optional server-only OpenAI adapter bootstrap. Other providers follow the same secret boundary.
# Never prefix provider secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=

# Storage provider abstraction: local is the Phase 0/default cPanel backend.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/media

# Transactional email (server-only). Password reset degrades safely when absent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM_NAME=Lisan
SMTP_FROM_EMAIL=

# Raw learner audio is not retained by default.
AUDIO_RETENTION_ENABLED=false

# Runtime
NODE_ENV=development
HOSTNAME=0.0.0.0
PORT=3000
